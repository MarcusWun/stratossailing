---
import Base from '../../layouts/Base.astro';

const albums = [
  {
    title: 'Offshore 160',
    href: '/gallery/offshore-160/',
    thumb: '/images/offshore-160/001.jpg',
    description: 'Singlehanded overnight race out of Newport — 160 nm in Rhode Island and Block Island Sound.',
    count: 10,
  },
  {
    title: 'Sailing on the Hudson',
    href: '/gallery/hudson-river/',
    thumb: '/images/hudson-river/007.jpg',
    description: 'Evening sail from the Hudson River into Upper New York Bay — Manhattan skyline, Statue of Liberty, sunset.',
    count: 9,
  },
  {
    title: 'Arriving in Newport',
    href: '/gallery/arriving-in-newport/',
    thumb: '/images/arriving-in-newport/001.jpg',
    description: 'Stratos arrives from the UK via Sevenstar, crane lift in Newport, and the delivery home to Jersey City.',
    count: 9,
  },
];
---
<Base title="Gallery">
  <h1 class="text-2xl font-bold mb-8">Gallery</h1>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {albums.map(album => (
      <a href={album.href} class="group block border border-gray-200 rounded overflow-hidden hover:border-gray-400 transition-colors">
        <div class="aspect-[4/3] overflow-hidden bg-gray-100">
          <img
            src={album.thumb}
            alt={album.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
        </div>
        <div class="p-4">
          <h2 class="font-semibold group-hover:underline">{album.title}</h2>
          <p class="text-sm text-gray-500 mt-1">{album.description}</p>
          <p class="text-xs text-gray-400 mt-2">{album.count} photos</p>
        </div>
      </a>
    ))}
  </div>
</Base>
