---
interface Slide {
  src: string;
  caption: string;
}
interface Props {
  id: string;
  slides: Slide[];
}
const { id, slides } = Astro.props;
---
<div class="carousel" id={id} aria-label="Photo gallery" tabindex="0">
  <div class="carousel-track" id={`${id}-track`}>
    {slides.map((slide, i) => (
      <div class="carousel-slide" data-index={i} role="img" aria-label={slide.caption}>
        <img src={slide.src} alt={slide.caption} loading={i === 0 ? 'eager' : 'lazy'} />
      </div>
    ))}
  </div>

  <button class="carousel-btn carousel-prev" data-carousel={id} data-dir="-1" aria-label="Previous photo">&#8592;</button>
  <button class="carousel-btn carousel-next" data-carousel={id} data-dir="1" aria-label="Next photo">&#8594;</button>

  <div class="carousel-caption" id={`${id}-caption`} aria-live="polite">
    {slides[0].caption}
  </div>

  <div class="carousel-dots" role="tablist">
    {slides.map((_, i) => (
      <button
        class={`carousel-dot${i === 0 ? ' active' : ''}`}
        data-carousel={id}
        data-index={i}
        aria-label={`Photo ${i + 1}`}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
      ></button>
    ))}
  </div>

  <div class="carousel-counter" id={`${id}-counter`} aria-hidden="true">
    1 / {slides.length}
  </div>
</div>

<style>
  .carousel {
    position: relative;
    width: 100%;
    max-width: 860px;
    background: #000;
    border-radius: 4px;
    overflow: hidden;
    user-select: none;
  }

  .carousel-track {
    display: flex;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  .carousel-slide {
    flex: 0 0 100%;
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111;
  }

  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.45);
    color: white;
    border: none;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.1rem;
    cursor: pointer;
    z-index: 10;
    transition: background 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
  }

  .carousel-btn:hover { background: rgba(0, 0, 0, 0.75); }
  .carousel-prev { left: 0.5rem; }
  .carousel-next { right: 0.5rem; }

  .carousel-caption {
    position: absolute;
    bottom: 2.25rem;
    left: 0;
    right: 0;
    background: rgba(0, 0, 0, 0.55);
    color: white;
    font-size: 0.8125rem;
    text-align: center;
    padding: 0.5rem 3rem;
    line-height: 1.4;
  }

  .carousel-counter {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    color: rgba(255,255,255,0.7);
    font-size: 0.75rem;
    z-index: 10;
  }

  .carousel-dots {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.375rem;
    z-index: 10;
  }

  .carousel-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s;
  }

  .carousel-dot.active { background: white; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.carousel').forEach(carousel => {
    const id = carousel.id;
    const track = document.getElementById(`${id}-track`) as HTMLElement;
    const caption = document.getElementById(`${id}-caption`) as HTMLElement;
    const counter = document.getElementById(`${id}-counter`) as HTMLElement;
    const dots = carousel.querySelectorAll<HTMLElement>('.carousel-dot');
    const total = dots.length;
    let current = 0;

    const captions = Array.from(
      carousel.querySelectorAll<HTMLElement>('.carousel-slide')
    ).map(s => s.getAttribute('aria-label') ?? '');

    function goTo(index: number) {
      current = (index + total) % total;
      track.style.transform = `translateX(-${current * 100}%)`;
      caption.textContent = captions[current];
      counter.textContent = `${current + 1} / ${total}`;
      dots.forEach((d, i) => {
        d.classList.toggle('active', i === current);
        d.setAttribute('aria-selected', String(i === current));
      });
    }

    carousel.querySelectorAll<HTMLElement>('.carousel-btn').forEach(btn => {
      btn.addEventListener('click', () => goTo(current + parseInt(btn.dataset.dir!)));
    });

    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    carousel.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') goTo(current - 1);
      if (e.key === 'ArrowRight') goTo(current + 1);
    });

    let touchStartX = 0;
    carousel.addEventListener('touchstart', (e: TouchEvent) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    carousel.addEventListener('touchend', (e: TouchEvent) => {
      const delta = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(delta) > 40) goTo(delta > 0 ? current + 1 : current - 1);
    }, { passive: true });
  });
</script>
